{
	"permissions": {
		"allow": [
			"WebSearch",
			"WebFetch(domain:claude.com)",
			"WebFetch(domain:gist.github.com)",
			"WebFetch(domain:cdn.playwright.dev)",
			"WebFetch(domain:playwright.download.prss.microsoft.com)",
			"WebFetch(domain:storage.googleapis.com)",
			"WebFetch(domain:fonts.googleapis.com)",
			"WebFetch(domain:fonts.gstatic.com)",
			"Bash(cmux claude-hook:*)",
			"Bash(cmux update:*)",
			"Bash(source:*)",
			"Bash(defaults read:*)",
			"Bash(chmod:*)",
			"Bash(git config:*)",
			"Bash(bash -n ~/.claude/hooks/task-completed-verify.sh)",
			"Bash(bash ~/.claude/hooks/task-completed-verify.sh)",
			"WebFetch(domain:json.schemastore.org)",
			"WebFetch(domain:www.schemastore.org)",
			"Bash(ps:*)",
			"Bash(/Users/operator/.local/bin/claude:*)",
			"Bash(npm run:*)",
			"Bash(npm test:*)"
		],
		"deny": [
			"Read(~/.ssh/**)",
			"Read(~/.aws/**)",
			"Read(~/.gnupg/**)",
			"Read(~/.config/op/**)",
			"Read(~/.config/gcloud/**)",
			"Read(~/.anthropic*)",
			"Read(~/.config/gh/hosts.yml)",
			"Read(~/.docker/config.json)",
			"Read(~/.netrc)",
			"Read(~/.pypirc)",
			"Read(~/.npmrc)",
			"Read(~/.gem/credentials)",
			"Read(~/.kube/**)",
			"Read(~/.git-credentials)",
			"Edit(~/.ssh/**)",
			"Edit(~/.gnupg/**)",
			"Edit(~/.aws/**)",
			"Edit(~/.kube/**)",
			"Edit(~/.pypirc)",
			"Edit(~/.gem/credentials)"
		]
	},
	"skillOverrides": {
		"notarize": "user-invocable-only",
		"icon": "user-invocable-only",
		"app-store": "user-invocable-only",
		"artifact-building": "off",
		"build.archived": "off",
