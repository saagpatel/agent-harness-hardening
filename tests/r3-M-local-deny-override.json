		"firecrawl-crawl.archived": "off",
		"firecrawl-download.archived": "off",
		"firecrawl-map.archived": "off",
		"firecrawl-scrape.archived": "off",
		"firecrawl-search.archived": "off",
		"firecrawl-download.archived": "off",
		"fix.archived": "off",
		"glean.archived": "off",
		"hermes-delegate": "off",
		"implementation-plan-generator": "off",
		"pre-flight-duplicate-check.archived": "off",
